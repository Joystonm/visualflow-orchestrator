# ============================================================
# Server-side only (NO VITE_ prefix — never bundled into the
# browser, read only by the /api/generate adapter). Required
# for Cloudinary Image Generation add-on:
# https://cloudinary.com/documentation/image_generation_addon
# ============================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional model fallback for requests without a known layer type.
# (Per-layer models are set in server/cloudinaryGenerate.ts: flux for base
# plates, nano-banana at reduced resolution for overlay passes.)
CLOUDINARY_GEN_MODEL_FAMILY=flux
CLOUDINARY_GEN_MODEL_TIER=standard

# Set to "pollinations" during development to use the free generator and
# preserve Cloudinary credits (free tier: 50 generations/month, ~6 per scene).
VITE_GEN_PROVIDER=

# ============================================================
# Authentication (optional — defaults are set in code)
# Override these in production/Vercel if you want different credentials
# ============================================================
VF_AUTH_EMAIL=
VF_AUTH_PASSWORD=

# ============================================================
# Client-safe (VITE_ prefix = shipped to the browser — put
# ONLY public values here, never keys or secrets).
# Used for unsigned uploads of fallback-generated assets.
# ============================================================
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
