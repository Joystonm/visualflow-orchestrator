{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/login.ts": { "maxDuration": 10 },
    "api/generate.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    {
      "source": "/api/image/:path*",
      "destination": "https://image.pollinations.ai/:path*"
    },
    {
      "source": "/api/text/:path*",
      "destination": "https://text.pollinations.ai/:path*"
    }
  ]
}
